  afterSnapshot     Json?             @map("after_snapshot")
  createdAt         DateTime          @default(now()) @map("created_at")

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace         Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  workflowRun       AIWorkflowRun?    @relation(fields: [workflowRunId], references: [id], onDelete: SetNull)
  agentRun          AIAgentRun?       @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  approval          Approval?         @relation(fields: [approvalId], references: [id], onDelete: SetNull)
  user              User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, workspaceId, overrideType, createdAt])
  @@index([tenantId, workflowRunId, createdAt])
  @@map("human_override_events")
}

model ApprovalAnalyticsEvent {
  id                String           @id @default(uuid())
  tenantId          String           @map("tenant_id")
  workspaceId       String?          @map("workspace_id")
  approvalId        String           @map("approval_id")
  workflowRunId     String?          @map("workflow_run_id")
  approverUserId    String?          @map("approver_user_id")
  status            ApprovalStatus   @map("status")
  decisionLatencyMs Int?             @map("decision_latency_ms")
  escalated         Boolean          @default(false) @map("escalated")
  createdAt         DateTime         @default(now()) @map("created_at")

  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace         Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  approval          Approval         @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  workflowRun       AIWorkflowRun?   @relation(fields: [workflowRunId], references: [id], onDelete: SetNull)
  approverUser      User?            @relation(fields: [approverUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, workspaceId, status, createdAt])
  @@index([tenantId, workflowRunId, createdAt])
  @@map("approval_analytics_events")
}

model HallucinationEvent {
  id                String             @id @default(uuid())
  tenantId          String             @map("tenant_id")
  workspaceId       String?            @map("workspace_id")
  workflowRunId     String?            @map("workflow_run_id")
  agentRunId        String?            @map("agent_run_id")
  userId            String?            @map("user_id")
  status            HallucinationStatus @default(SUSPECTED)
  severity          String?            @map("severity")
  detectionSource   String?            @map("detection_source") // self_check, reviewer, human_flag, external_validator
  claim             String?            @map("claim")
  evidence          Json?              @map("evidence")
  correctedBy       String?            @map("corrected_by")
  correctedAt       DateTime?          @map("corrected_at")
  createdAt         DateTime           @default(now()) @map("created_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace         Workspace?         @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  workflowRun       AIWorkflowRun?     @relation(fields: [workflowRunId], references: [id], onDelete: SetNull)
  agentRun          AIAgentRun?        @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  user              User?              @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, workspaceId, status, createdAt])
  @@index([tenantId, workflowRunId, createdAt])
  @@map("hallucination_events")
}

model AIWorkflowMetricRollup {
  id                 String            @id @default(uuid())
  tenantId           String            @map("tenant_id")
  workspaceId        String?           @map("workspace_id")
  workflowKey        String            @map("workflow_key")
  granularity        MetricGranularity @map("granularity")
  periodStart        DateTime          @map("period_start")
  periodEnd          DateTime          @map("period_end")
  runCount           Int               @default(0) @map("run_count")
  successCount       Int               @default(0) @map("success_count")
  failureCount       Int               @default(0) @map("failure_count")
  cancellationCount  Int               @default(0) @map("cancellation_count")
  avgLatencyMs       Float?            @map("avg_latency_ms")
  p95LatencyMs       Float?            @map("p95_latency_ms")
  totalInputTokens   BigInt            @default(0) @map("total_input_tokens")
  totalOutputTokens  BigInt            @default(0) @map("total_output_tokens")
  totalCostUsd       Decimal           @default(0) @db.Decimal(18, 6) @map("total_cost_usd")
  avgConfidence      Float?            @map("avg_confidence")
  overrideRate       Float?            @map("override_rate")
  approvalRate       Float?            @map("approval_rate")
  hallucinationRate  Float?            @map("hallucination_rate")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace          Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@unique([tenantId, workspaceId, workflowKey, granularity, periodStart])
  @@index([tenantId, periodStart, periodEnd])
  @@index([tenantId, workspaceId, workflowKey, granularity, periodStart])
  @@map("ai_workflow_metric_rollups")
}

